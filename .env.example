# Local-development configuration for Market Pulse.
# Copy to .env and adjust if desired. The defaults below match every other
# service's assumptions (MinIO, Trino, dbt profiles.yml) and are safe ONLY for
# a stack that is not reachable from outside your machine.

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Iceberg REST catalog (talks to MinIO via the S3 API) ---
# Must match MINIO_ROOT_USER/PASSWORD above unless you've created a separate
# MinIO user for the catalog.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# --- Pipeline (ingestion) credentials ---
# Populated by `terraform output` after `terraform apply` in infra/terraform —
# see the Quick Start section of the README. Placeholders here will not work
# until you replace them with real Terraform outputs.
PIPELINE_ACCESS_KEY=terraform_output_pipeline_access_key
PIPELINE_SECRET_KEY=terraform_output_pipeline_secret_key

# --- Superset ---
# SUPERSET_SECRET_KEY signs session cookies; generate a real one with
# `python -c "import secrets; print(secrets.token_urlsafe(42))"` for anything
# beyond a local demo. SUPERSET_ADMIN_* set the bootstrap admin account.
SUPERSET_SECRET_KEY=please-change-me-to-a-long-random-string-1234567890
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- Optional: Slack failure alerting ---
# Leave unset to disable; the Airflow DAG logs a warning instead of failing.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Optional: observability (Prometheus + Grafana) ---
# No credentials required beyond Grafana's own default admin/admin login at
# http://localhost:3000, set in docker-compose.observability.yml. Not
# overridable via this file today — see Known limitations in the README.
