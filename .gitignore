# Secrets — never commit these
.env
.env.*
!.env.example
*.tfstate
*.tfstate.backup
*.tfplan
.terraform/
.terraform.lock.hcl

# dbt
dbt/market_pulse/target/
dbt/market_pulse/dbt_packages/
dbt/market_pulse/logs/
# Regenerated by `dbt deps`; historically incompatible across dbt patch
# versions when committed (see git log) — not tracked.
dbt/market_pulse/package-lock.yml

# Python
__pycache__/
*.pyc
*.pyo
.python-version
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Airflow
logs/
airflow_auth/
*.db
*.sqlite3

# Docker / local data volumes
*.log
minio_data/
pg_data/

# Benchmarks — machine-specific, regenerated per run
benchmarks/results/*
!benchmarks/results/.gitkeep

# macOS / IDE
.DS_Store
.vscode/
.idea/
